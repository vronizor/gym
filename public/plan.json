 "rules": [
  {
   "id": "R1",
   "text": "Priority when time is short: quality (T/AT) > long MTB (L) > long tempo (C) > torque (B) > easy spin and strength. Drop from the bottom."
  },
  {
   "id": "R2",
   "text": "Missed sessions are never stacked. A missed quality session may move within the same week if it stays 48 h away from the next hard session; otherwise it's gone."
  },
  {
   "id": "R3",
   "text": "A week counts as done when the quality session was completed and at least 70% of planned hours were ridden; partial between 40% and 70% or without the quality session; missed below 40%."
  },
  {
   "id": "R4",
   "text": "Advance to the next week's targets only if the last quality session was completed as written. If intervals were cut short or average power fell more than 3% below the band, repeat that session next week with targets 3% lower. Perceived exertion 9–10 on a threshold session also counts as not completed as written."
  },
  {
   "id": "R5",
   "text": "Two partial or missed weeks in a row: repeat the last completed week instead of advancing. The remaining weeks of that block shift; the taper and race week never move."
  },
  {
   "id": "R6",
   "text": "Three or more weeks off (illness, travel): restart two quality steps below the last one completed, without a recovery week first."
  },
  {
   "id": "R7",
   "text": "Perceived exertion 9–10 on an endurance or tempo session, or descriptions mentioning sickness, bad nights or exhaustion (in any language): next week keep the quality session only if he seems well, drop torque, cut long sessions by 30%. Sick: no intensity until two symptom-free days."
  },
  {
   "id": "R8",
   "text": "Unplanned rides count. An outdoor ride of 2.5 h+ with 1,000 m+ counts as the long MTB ride; 90′+ counts as long tempo. After a weekend ride with relative effort above 250, Monday is rest and the quality session moves to Tuesday or later."
  },
  {
   "id": "R9",
   "text": "If the MTB weekend falls on a different week than planned, swap that week's long tempo (C) with the nearest long MTB ride (L)."
  },
  {
   "id": "R10",
   "text": "Recovery weeks stay recovery weeks, even on good legs."
  },
  {
   "id": "R11",
   "text": "Change at most one variable per session per week: reps, duration, or targets by 3–5% FTP. No new workouts that would need rebuilding in COROS."
  },
  {
   "id": "R12",
   "text": "Three quality sessions in a row at full targets with perceived exertion 6 or below: bring the next FTP test forward."
  },
  {
   "id": "R13",
   "text": "If more than two weeks behind schedule entering May (week 18), skip ahead to the race-specific block rather than compressing; drop the missed progressions."
  },
  {
   "id": "R14",
   "text": "Every adjustment names the rule it applies. If Strava can't be read, write a report saying so and change nothing."
  }
 ],
